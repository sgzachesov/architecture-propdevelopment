        <mxCell id="pub-d" value="&lt;b&gt;Состав данных&lt;/b&gt;&lt;div&gt;• Онлайн-витрина&lt;/div&gt;&lt;div&gt;• Планировки объектов&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F4F7F4;strokeColor=#AAB7AA;fontColor=#333333;verticalAlign=top;align=left;spacing=8;fontSize=11;" parent="1" vertex="1">
