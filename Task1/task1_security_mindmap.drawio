        <mxCell id="int-d" value="&lt;b&gt;Состав данных&lt;/b&gt;&lt;div&gt;• BI-аналитика и отчётность&lt;/div&gt;&lt;div&gt;• Услуги ЖКУ&lt;/div&gt;&lt;div&gt;• Планы работ&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F2F6FA;strokeColor=#A9BFCF;fontColor=#333333;verticalAlign=top;align=left;spacing=8;fontSize=11;" parent="1" vertex="1">
