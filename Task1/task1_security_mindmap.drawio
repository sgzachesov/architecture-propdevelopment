          <mxGeometry x="1270" y="1254" width="300" height="46" as="geometry" />
        </mxCell>
        <mxCell id="sec-r2" value="&lt;b&gt;Потеря данных&lt;/b&gt;&lt;div&gt;Оценка: критический&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E74C3C;strokeColor=#922B21;fontColor=#FFFFFF;verticalAlign=middle;fontSize=11;" parent="1" vertex="1">
